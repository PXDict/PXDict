{
  "name": "@pxdict/gateway",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "pxdict-gateway: the single entry point in front of wuDict (PWA, /app-api, allowlisted proxy).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/pxdict-gateway.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "auth:schema": "node scripts/gen-auth-schema.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.28",
    "@hono/node-server": "^2.1.11",
    "@pxdict/shared": "*",
    "better-auth": "1.7.28",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "nodemailer": "^10.6.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.2",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
