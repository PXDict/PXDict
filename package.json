{
  "name": "pxdict",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "shared",
    "gateway",
    "pwa"
  ],
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "gen:api": "npm run gen:api -w @pxdict/shared --"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
