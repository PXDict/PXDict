{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    // Workbox's plugin classes declare optional members as `T | undefined`, which its own
    // WorkboxPlugin type rejects under exactOptionalPropertyTypes.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/sw", "src/lib/cache-names.ts", "src/lib/paths.ts"]
}
