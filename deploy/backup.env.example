# Settings for scripts/backup.sh and scripts/server-update.sh when run by systemd
# (deploy/systemd/pxdict-{backup,update}.service). Copy to /opt/pxdict/backup.env, `chmod 600`.

# Encryption, one of (see scripts/backup.sh):
BACKUP_AGE_RECIPIENTS=/opt/pxdict/backup-recipients.txt
# BACKUP_GPG_PASSPHRASE_FILE=/root/.pxdict-backup-passphrase
# BACKUP_UNENCRYPTED=1

BACKUP_DIR=/var/backups/pxdict
BACKUP_KEEP=14

# Back up before each update that changes the image (server-update.sh).
PXDICT_BACKUP_BEFORE_UPDATE=1
