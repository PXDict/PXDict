# PXDict settings for deploy/compose.yaml. Copy to /opt/pxdict/.env, fill in, then `chmod 600 .env`.
# Every PXDict variable is documented in gateway/README.md#configuration; blank values count as unset.
# This file holds secrets: never commit it.

# --- Compose ----------------------------------------------------------------------------------------
# Image tag: `latest` follows every tested build; pin (e.g. :wudict-v3.7.11, :1.2.0) to roll back or to
# choose when updates happen (docs/operations.md#rolling-back).
PXDICT_IMAGE=ghcr.io/thanhhvnqb/pxdict:latest
# `cloudflared` starts the tunnel service; leave empty when you run your own reverse proxy.
COMPOSE_PROFILES=cloudflared
# From Zero Trust → Networks → Tunnels → your tunnel (docs/operations.md#cloudflare-tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Required ---------------------------------------------------------------------------------------
# The origin users open: scheme + host, no path. Passkeys are bound to this host name, so choose it
# before users register passkeys (or keep AUTH_PASSKEY=false until it is final).
PUBLIC_URL=https://dict.example.com
# Signs session cookies and encrypts OAuth tokens. Leave empty to have one generated and kept in
# data/gateway/better-auth-secret, or set your own: openssl rand -hex 32. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Behind Cloudflare: the real client address for rate limits. Only set it when every request passes
# that proxy (true here: the app publishes no port). Own reverse proxy: x-forwarded-for.
CLIENT_IP_HEADER=cf-connecting-ip
TZ=Etc/UTC

# --- First admin (used only while no admin exists) ----------------------------------------------------
# Without ADMIN_PASSWORD a one-time password is printed in `docker compose logs app`.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Accounts -----------------------------------------------------------------------------------------
# closed (admins create users) | invite (single-use codes) | open. Applies to every sign-in method.
REGISTRATION=closed
# AUTH_PASSKEY=true
# AUTH_REQUIRE_2FA_ADMIN=false
# AUTH_HIBP=false

# --- Email (verification, password reset, magic links, email codes) ------------------------------------
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=PXDict <dict@example.com>

# --- Social sign-in (redirect URI: ${PUBLIC_URL}/app-api/auth/callback/<provider>) ---------------------
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_TENANT_ID=common
# AUTH_APPLE_CLIENT_ID=
# AUTH_APPLE_CLIENT_SECRET=
# AUTH_DISCORD_CLIENT_ID=
# AUTH_DISCORD_CLIENT_SECRET=
# AUTH_FACEBOOK_CLIENT_ID=
# AUTH_FACEBOOK_CLIENT_SECRET=
# AUTH_GITLAB_CLIENT_ID=
# AUTH_GITLAB_CLIENT_SECRET=
# AUTH_GITLAB_ISSUER=https://gitlab.example.com

# --- Any OpenID Connect provider (<NAME>: upper-case letters/digits; callback uses its lower case) -----
# AUTH_OIDC_AUTHENTIK_ISSUER=https://auth.example.com/application/o/pxdict/
# AUTH_OIDC_AUTHENTIK_CLIENT_ID=
# AUTH_OIDC_AUTHENTIK_CLIENT_SECRET=
# AUTH_OIDC_AUTHENTIK_LABEL=Authentik

# --- Dictionary proposals and storage ---------------------------------------------------------------------
# Uploads are chunked (32 MiB per request), so Cloudflare's 100 MB request limit does not cap this.
# MAX_UPLOAD_BYTES=500MB
# MAX_PENDING_PROPOSALS_PER_USER=3
# MAX_PENDING_BYTES=5GB
# MIN_FREE_BYTES=1GB
# BUILTIN_DICT_VISIBILITY=global
# HISTORY_DEFAULT_RETENTION_DAYS=90

# --- Memory (docs/operations.md#memory) -------------------------------------------------------------------
# Layer 1, soft limits inside the container: wuDict's Go runtime and the gateway's V8 heap.
# MEMORY_LIMIT=400MB
# GATEWAY_MAX_OLD_SPACE_MB=128
# INDEX_WORKERS=1
# PREVIEW_MEMORY=128MB
# SEARCH_MEMORY=128MB
# Layers 2 and 3, read by compose.yaml: hard RAM cap, and RAM + swap.
# PXDICT_MEM_LIMIT=768m
# PXDICT_MEMSWAP_LIMIT=2560m

# LOG_LEVEL=info

# --- Metrics (docs/operations.md#metrics, ADR 0010) ---------------------------------------------------------
# Prometheus metrics at /metrics for admins, and for scrapers sending "Authorization: Bearer <token>".
# METRICS=true
# A random token for scrapers (openssl rand -hex 32); optional, admins can always open /metrics.
# METRICS_TOKEN=
